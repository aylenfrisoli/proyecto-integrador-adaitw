{
  "_leeme": "Requests de Postman de la caminata, sacados de la coleccion. Para volver a ponerlos: sumar 'carpeta' como carpeta de la coleccion (antes de Configuracion) y los requests de 'borrados' dentro de la carpeta de borrados, antes de 'Borrar categoria (ya sin obras ni productos)'. Usan las variables de coleccion caminataId y caminataSinFotosId, que los mismos requests crean.",
  "carpeta": {
    "name": "6. Caminatas",
    "item": [
      {
        "name": "Crear edicion con fotos",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"responde 201\", () => pm.response.to.have.status(201));",
                "const caminata = pm.response.json();",
                "pm.collectionVariables.set(\"caminataId\", caminata._id);",
                "pm.test(\"guarda las dos fotos\", () => pm.expect(caminata.fotos).to.have.length(2));",
                "pm.test(\"el epigrafe se guarda sin los espacios de los costados\", () => pm.expect(caminata.fotos[0].epigrafe).to.eql(\"Salida desde la costanera\"));",
                "pm.test(\"un epigrafe vacio no se guarda\", () => pm.expect(caminata.fotos[1]).to.not.have.property(\"epigrafe\"));",
                "pm.test(\"las fotos no llevan id propio\", () => pm.expect(caminata.fotos[0]).to.not.have.property(\"_id\"));",
                "pm.test(\"la fecha queda al mediodia de argentina\", () => pm.expect(caminata.fecha).to.eql(\"2026-04-12T15:00:00.000Z\"));"
              ]
            }
          }
        ],
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "url": {
            "raw": "{{baseUrl}}/caminatas",
            "host": [
              "{{baseUrl}}"
            ],
            "path": [
              "caminatas"
            ]
          },
          "body": {
            "mode": "raw",
            "raw": "{\n  \"nombre\": \"Edicion de prueba Postman\",\n  \"fecha\": \"2026-04-12T12:00:00-03:00\",\n  \"lugar\": \"Costanera de prueba\",\n  \"descripcion\": \"Edicion creada por la coleccion de Postman\",\n  \"fotos\": [\n    {\n      \"url\": \"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxIiBoZWlnaHQ9IjEiPjwvc3ZnPg==\",\n      \"epigrafe\": \"  Salida desde la costanera  \"\n    },\n    {\n      \"url\": \"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxIiBoZWlnaHQ9IjEiPjwvc3ZnPg==\",\n      \"epigrafe\": \"\"\n    }\n  ]\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          }
        }
      },
