# puerto donde escucha la api, render lo reemplaza por el suyo al deployar
PORT=3000

# uri de conexion a mongodb atlas, se copia desde el boton connect del cluster
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/sara-figarra

# clave para firmar los tokens, tiene que ser larga y dificil de adivinar
JWT_SECRET=cambiar_por_una_clave_larga_y_secreta
# cuanto dura la sesion antes de tener que loguearse de nuevo
JWT_EXPIRES_IN=1d

# url del frontend que puede consumir la api, en desarrollo es la de vite
CORS_ORIGIN=http://localhost:5173

# datos para crear la cuenta de administradora con el script seed
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambiar_por_una_password_segura
